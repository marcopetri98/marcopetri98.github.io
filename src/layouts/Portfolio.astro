---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
    title: string;
    description: string;
    heroImage?: ImageMetadata;
    subtitle?: string;
    location?: string;
    email?: string;
    bio?: string;
}

const { title, description, heroImage, subtitle, location, email, bio } =
    Astro.props;
---

<html lang="en">
    <head>
        <BaseHead title={title} description={description} />
        <style>
            main {
                width: calc(100% - 2em);
                max-width: 100%;
                margin: 0;
            }
            .hero-section {
                width: 100%;
                padding: 2em 1em;
                text-align: center;
                background: linear-gradient(
                    135deg,
                    rgba(var(--accent-light), 0.1) 0%,
                    rgba(var(--accent), 0.05) 100%
                );
            }
            .hero-image {
                width: 120px;
                height: 120px;
                margin: 0 auto 1em;
            }
            .hero-image img {
                display: block;
                width: 100%;
                height: 100%;
                border-radius: 50%;
                border: 4px solid rgb(var(--accent));
                object-fit: cover;
            }
            .hero-content h1 {
                margin: 0 0 0.5em 0;
                font-size: 2.5em;
                color: rgb(var(--gray-dark));
            }
            .hero-subtitle {
                font-size: 1.25em;
                color: rgb(var(--accent));
                margin-bottom: 0.5em;
            }
            .hero-meta {
                display: flex;
                justify-content: center;
                gap: 1.5em;
                flex-wrap: wrap;
                margin: 1em 0;
                font-size: 0.95em;
                color: rgb(var(--gray));
            }
            .hero-meta-item {
                display: flex;
                align-items: center;
                gap: 0.5em;
            }
            .bio {
                max-width: 720px;
                margin: 1.5em auto 0;
                padding: 1.5em;
                color: rgb(var(--gray-dark));
                line-height: 1.6;
                font-size: 1.05em;
                background-color: rgba(var(--accent), 0.08);
                border: 1px solid rgba(var(--accent), 0.2);
                border-radius: 6px;
            }

            .prose {
                width: 720px;
                max-width: calc(100% - 2em);
                margin: 0 auto;
                padding: 1em;
                color: rgb(var(--gray-dark));
            }

            .sections-container {
                padding: 2em 1em;
            }

            @media (max-width: 720px) {
                .hero-content h1 {
                    font-size: 2em;
                }
                .hero-image {
                    width: 100px;
                    height: 100px;
                }
                .hero-meta {
                    gap: 1em;
                }
            }
        </style>
    </head>

    <body>
        <Header />
        <main>
            <!-- Hero Section -->
            <section class="hero-section">
                <div class="hero-content">
                    {
                        heroImage && (
                            <div class="hero-image">
                                <Image
                                    width={120}
                                    height={120}
                                    src={heroImage}
                                    alt={title}
                                />
                            </div>
                        )
                    }
                    <h1>{title}</h1>
                    {subtitle && <div class="hero-subtitle">{subtitle}</div>}
                    <div class="hero-meta">
                        {
                            location && (
                                <div class="hero-meta-item">
                                    <span>📍</span>
                                    <span>{location}</span>
                                </div>
                            )
                        }
                        {
                            email && (
                                <div class="hero-meta-item">
                                    <span>✉️</span>
                                    <a href={`mailto:${email}`}>{email}</a>
                                </div>
                            )
                        }
                    </div>
                    {bio && <div class="bio">{bio}</div>}
                </div>
            </section>

            <!-- Portfolio Sections -->
            <article class="sections-container">
                <slot />
            </article>
        </main>
        <Footer />
    </body>
</html>
