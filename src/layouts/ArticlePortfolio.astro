---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
    title: string;
    description: string;
    intro?: string;
}

const { title, description, intro = description } = Astro.props;

const introParagraphs = intro
    .split(/\n\s*\n/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean);
---

<html lang="en">
    <head>
        <BaseHead title={title} description={description} />
        <style>
            main {
                width: calc(100% - 2em);
                max-width: 100%;
                margin: 0;
            }

            .page-shell {
                width: min(880px, calc(100% - 2rem));
                margin: 0 auto;
                padding: 3.5rem 0 4rem;
            }

            .intro {
                margin-bottom: 3rem;
                padding: 0 0 2rem;
                border-bottom: 1px solid rgb(var(--gray-light));
            }

            .intro h1 {
                margin: 0 0 1rem;
                font-size: clamp(2.5rem, 5vw, 4rem);
                line-height: 1.05;
                color: rgb(var(--gray-dark));
            }

            .intro-copy {
                max-width: 720px;
                color: rgb(var(--gray-dark));
            }

            .intro-copy p {
                margin: 0 0 1.25rem;
                font-size: 1.05rem;
                line-height: 1.8;
            }

            .content {
                display: flex;
                flex-direction: column;
                gap: 2rem;
            }

            @media (max-width: 720px) {
                .page-shell {
                    width: min(100%, calc(100% - 1.25rem));
                    padding-top: 2.5rem;
                }

                .intro {
                    margin-bottom: 2.25rem;
                    padding-bottom: 1.5rem;
                }

                .intro-copy p {
                    font-size: 1rem;
                }
            }
        </style>
    </head>

    <body>
        <Header />
        <main>
            <div class="page-shell">
                <article class="intro">
                    <h1>{title}</h1>
                    <div class="intro-copy">
                        {introParagraphs.map((paragraph) => <p>{paragraph}</p>)}
                    </div>
                </article>

                <div class="content">
                    <slot />
                </div>
            </div>
        </main>
        <Footer />
    </body>
</html>
