---
interface Award {
    name: string;
    issuer?: string;
    date?: string;
    position?: string;
}

interface Props {
    title?: string;
    awards: Award[];
}

const { title = "Awards", awards } = Astro.props;
---

<section class="awards">
    <div class="section-heading">
        <h2>{title}</h2>
    </div>

    <ol class="awards-list">
        {
            awards.map((award) => (
                <li class="award-card">
                    <article>
                        <h3>{award.name}</h3>

                        {(award.issuer || award.date) && (
                            <p class="award-meta">
                                {award.issuer && (
                                    <span class="meta-item">{award.issuer}</span>
                                )}
                                {award.date && (
                                    <span class="meta-item">{award.date}</span>
                                )}
                            </p>
                        )}

                        {award.position && (
                            <p class="award-position">{award.position}</p>
                        )}
                    </article>
                </li>
            ))
        }
    </ol>
</section>

<style>
    .awards {
        width: 720px;
        margin: 0 auto;
    }

    .section-heading {
        margin-bottom: 1.25rem;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid var(--accent);
    }

    .section-heading h2 {
        margin: 0;
        font-size: 1.9rem;
        color: rgb(var(--gray-dark));
    }

    .awards-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 1rem;
    }

    .award-card {
        margin: 0;
        padding: 1.5rem;
        background: rgba(var(--section-dark), 0.12);
        border: 1px solid rgba(var(--section-dark), 0.24);
        border-radius: 12px;
    }

    .award-card h3 {
        margin: 0 0 0.5rem;
        font-size: 1.2rem;
        line-height: 1.35;
        color: rgb(var(--gray-dark));
    }

    .award-meta {
        display: flex;
        flex-wrap: wrap;
        margin: 0;
        color: rgb(var(--gray));
        font-size: 0.95rem;
    }

    .meta-item:not(:first-child) {
        white-space: nowrap;
    }

    .meta-item:not(:first-child)::before {
        content: "•";
        margin: 0 0.35rem;
        color: rgb(var(--gray));
    }

    .award-position {
        display: inline-block;
        margin: 0.9rem 0 0;
        padding: 0.3rem 0.8rem;
        border-radius: 999px;
        background: rgba(var(--section-light), 0.65);
        color: var(--accent-dark);
        font-size: 0.88rem;
        font-weight: 600;
    }

    @media (max-width: 720px) {
        .section-heading h2 {
            font-size: 1.6rem;
        }

        .award-card {
            padding: 1.1rem;
        }
    }
</style>
