---
import ShowMore from "./ShowMore.astro";

interface PublicationLink {
    label: string;
    href: string;
}

type PublicationType = "journal" | "conference" | "preprint" | "thesis";

interface Publication {
    title: string;
    type?: PublicationType;
    authors?: string;
    venue?: string;
    year?: string | number;
    abstract?: string;
    href?: string;
    links?: PublicationLink[];
    bibtex?: string;
}

interface Props {
    publications: Publication[];
    limit?: number;
    highlightAuthor?: string;
}

const {
    publications,
    limit = publications.length,
    highlightAuthor,
} = Astro.props;

const hiddenCount = Math.max(0, publications.length - limit);

const TYPE_LABELS: Record<PublicationType, string> = {
    journal: "Journal",
    conference: "Conference",
    preprint: "Preprint",
    thesis: "Thesis",
};

function splitAuthors(authors: string): string[] {
    return highlightAuthor ? authors.split(highlightAuthor) : [authors];
}
---

<ShowMore hiddenCount={hiddenCount}>
    <ol class="pub-list">
        {
            publications.map((publication, index) => (
                <li
                    class="pub"
                    data-extra={index >= limit ? "true" : undefined}
                >
                    <div class="pub-side">
                        <span class="pub-year">{publication.year}</span>
                        {publication.type && (
                            <span class={`pub-type pub-type--${publication.type}`}>
                                {TYPE_LABELS[publication.type]}
                            </span>
                        )}
                    </div>
                    <article class="pub-body">
                        <h3 class="pub-title">
                            {publication.href ? (
                                <a href={publication.href} target="_blank">
                                    {publication.title}
                                </a>
                            ) : (
                                publication.title
                            )}
                        </h3>

                        {publication.authors && (
                            <p class="pub-authors">
                                {splitAuthors(publication.authors).map(
                                    (part, partIndex) => (
                                        <>
                                            {partIndex > 0 && (
                                                <strong>{highlightAuthor}</strong>
                                            )}
                                            {part}
                                        </>
                                    ),
                                )}
                            </p>
                        )}

                        {publication.venue && (
                            <p class="pub-venue">{publication.venue}</p>
                        )}

                        {(publication.abstract ||
                            publication.bibtex ||
                            (publication.links &&
                                publication.links.length > 0)) && (
                            <div class="pub-actions">
                                {publication.abstract && (
                                    <button
                                        type="button"
                                        class="pub-action pub-abstract-toggle"
                                        aria-expanded="false"
                                        aria-controls={`publication-abstract-${index}`}
                                    >
                                        Abstract
                                    </button>
                                )}
                                {publication.bibtex && (
                                    <button
                                        type="button"
                                        class="pub-action pub-bibtex"
                                        data-bibtex={publication.bibtex}
                                        aria-live="polite"
                                    >
                                        BibTeX
                                    </button>
                                )}
                                {publication.links?.map((link) => (
                                    <a
                                        class="pub-action"
                                        href={link.href}
                                        target="_blank"
                                    >
                                        {link.label} ↗
                                    </a>
                                ))}
                            </div>
                        )}

                        {publication.abstract && (
                            <p
                                id={`publication-abstract-${index}`}
                                class="pub-abstract"
                                hidden
                            >
                                {publication.abstract}
                            </p>
                        )}
                    </article>
                </li>
            ))
        }
    </ol>
</ShowMore>

<style>
    .pub-list {
        display: grid;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .pub {
        display: grid;
        grid-template-columns: 5.5rem minmax(0, 1fr);
        gap: 1rem;
        padding: 0.9rem 0;
        border-top: 1px solid rgba(var(--section-dark), 0.5);
    }

    .pub:first-child {
        border-top: none;
        padding-top: 0;
    }

    .pub-side {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.35rem;
        padding-top: 0.1rem;
    }

    .pub-year {
        color: var(--accent);
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.04em;
    }

    .pub-type {
        padding: 0.08rem 0.45rem;
        border-radius: 999px;
        font-size: 0.66rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .pub-type--journal {
        background: rgba(var(--section-light), 0.9);
        color: var(--accent-dark);
    }

    .pub-type--conference {
        background: #e2f3e8;
        color: #17663a;
    }

    .pub-type--preprint {
        background: #fcefd4;
        color: #8a5a00;
    }

    .pub-type--thesis {
        background: #efe6fb;
        color: #5b2a9b;
    }

    :global([data-theme="dark"]) .pub-type--conference {
        background: rgba(52, 168, 98, 0.18);
        color: #7fd8a3;
    }

    :global([data-theme="dark"]) .pub-type--preprint {
        background: rgba(230, 170, 40, 0.18);
        color: #f2c46b;
    }

    :global([data-theme="dark"]) .pub-type--thesis {
        background: rgba(160, 110, 230, 0.2);
        color: #cfb2f5;
    }

    .pub-title {
        margin: 0 0 0.3rem;
        font-size: 1.02rem;
        line-height: 1.4;
        color: rgb(var(--gray-dark));
    }

    .pub-title a {
        color: inherit;
        text-decoration: none;
    }

    .pub-title a:hover {
        color: var(--accent);
    }

    .pub-authors,
    .pub-venue {
        margin: 0;
        color: rgb(var(--gray));
        font-size: 0.88rem;
        line-height: 1.5;
    }

    .pub-authors strong {
        color: rgb(var(--gray-dark));
    }

    .pub-venue {
        font-style: italic;
    }

    .pub-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: 0.6rem;
    }

    .pub-action {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.12rem 0.6rem;
        border: 1px solid rgba(var(--section-dark), 0.8);
        border-radius: 999px;
        background: transparent;
        color: var(--accent);
        font: inherit;
        font-size: 0.78rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

    .pub-action:hover,
    .pub-action:focus-visible {
        background: rgba(var(--section-light), 0.65);
        color: var(--accent-dark);
    }

    .pub-bibtex.is-copied {
        border-color: var(--accent);
        background: var(--accent);
        color: rgb(var(--on-accent));
    }

    .pub-abstract-toggle::after {
        content: "";
        width: 0.3rem;
        height: 0.3rem;
        border-right: 1.5px solid currentColor;
        border-bottom: 1.5px solid currentColor;
        transform: translateY(-0.1rem) rotate(45deg);
        transition: transform 0.2s ease;
    }

    .pub-abstract-toggle[aria-expanded="true"]::after {
        transform: translateY(0.1rem) rotate(-135deg);
    }

    .pub-abstract {
        margin: 0.7rem 0 0;
        color: rgb(var(--gray-dark));
        font-size: 0.9rem;
        line-height: 1.65;
        text-align: justify;
    }

    @media (max-width: 720px) {
        .pub {
            grid-template-columns: 1fr;
            gap: 0.3rem;
        }

        .pub-side {
            flex-direction: row;
            align-items: center;
            gap: 0.5rem;
        }
    }
</style>

<script>
    document
        .querySelectorAll<HTMLButtonElement>(".pub-abstract-toggle")
        .forEach((button) => {
            const abstract = document.getElementById(
                button.getAttribute("aria-controls") ?? "",
            );
            if (abstract) {
                button.addEventListener("click", () => {
                    const expanded =
                        button.getAttribute("aria-expanded") === "true";
                    button.setAttribute("aria-expanded", String(!expanded));
                    abstract.hidden = expanded;
                });
            }
        });

    const COPIED_FEEDBACK_MS = 1800;

    async function copyBibtex(button: HTMLButtonElement): Promise<void> {
        await navigator.clipboard.writeText(button.dataset.bibtex ?? "");
        button.textContent = "Copied!";
        button.classList.add("is-copied");
        setTimeout((): void => {
            button.textContent = "BibTeX";
            button.classList.remove("is-copied");
        }, COPIED_FEEDBACK_MS);
    }

    document
        .querySelectorAll<HTMLButtonElement>(".pub-bibtex")
        .forEach((button) => {
            button.addEventListener("click", () => copyBibtex(button));
        });
</script>
