---
import type { CollectionEntry, CollectionKey } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

interface Props {
	latestPosts: CollectionEntry<CollectionKey>[];
	title?: string;
	description?: string;
	emptyMessage?: string;
	variant?: "landing" | "home";
}

const {
	latestPosts,
	title = "Latest Articles",
	description,
	emptyMessage = "There are no recent articles to show yet.",
	variant = "landing",
} = Astro.props;
---

<section class:list={["latest-section", `latest-section--${variant}`]} aria-labelledby="latest-articles">
	<div class="section-heading">
		<div>
			<h2 id="latest-articles">{title}</h2>
			{description && <p>{description}</p>}
		</div>
	</div>

	<div class="latest-panel">
		{
			latestPosts.length > 0 ? (
				<ol class="latest-list">
					{latestPosts.map((post, index) => (
						<li class="latest-item">
							<a href={`/${post.collection}/${post.id}/`}>
								<div class="latest-index">{String(index + 1).padStart(2, "0")}</div>
								<div class="latest-copy">
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
								</div>
								<div class="latest-date">
									<FormattedDate date={post.data.pubDate} />
								</div>
							</a>
						</li>
					))}
				</ol>
			) : (
				<div class="empty-state">{emptyMessage}</div>
			)
		}
	</div>
</section>

<style>
	.latest-section {
		--latest-muted: var(--landing-muted, var(--home-muted, #52607a));
		--latest-ink: var(--landing-ink, var(--home-ink, #0f172a));
		--latest-accent: var(--landing-accent, var(--home-accent, #c84c2a));
		--latest-accent-soft: var(
			--landing-accent-soft,
			var(--home-accent-soft, rgba(200, 76, 42, 0.1))
		);
		--latest-border: var(
			--landing-border,
			var(--home-border, rgba(15, 23, 42, 0.12))
		);
	}

	.latest-section--landing .section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin: 3rem 0 1.25rem;
	}

	.latest-section--landing .section-heading h2 {
		margin: 0;
		font-size: clamp(1.8rem, 3vw, 2.8rem);
	}

	.latest-section--landing .section-heading p {
		margin: 0;
		color: var(--latest-muted);
		font-size: 0.95rem;
	}

	.latest-section--landing .latest-panel {
		padding: 1rem;
		border: 1px solid var(--latest-border);
		border-radius: 28px;
		background: var(--landing-panel, rgba(255, 253, 250, 0.8));
		backdrop-filter: blur(8px);
	}

	.latest-section--home .section-heading {
		margin-bottom: 1.4rem;
	}

	.latest-section--home .section-heading h2 {
		margin: 0 0 0.35rem;
		font-size: clamp(1.8rem, 3vw, 2.5rem);
		color: var(--latest-ink);
	}

	.latest-section--home .section-heading p {
		margin: 0;
		color: var(--latest-muted);
		line-height: 1.7;
	}

	.latest-section--home .latest-panel {
		padding: 0;
	}

	.latest-list {
		display: grid;
		gap: 0.85rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.latest-item a {
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: 1rem;
		align-items: center;
		padding: 1rem 1.1rem;
		border-radius: 18px;
		color: inherit;
		text-decoration: none;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			border-color 0.2s ease,
			background 0.2s ease;
	}

	.latest-section--landing .latest-item a {
		background: rgba(255, 255, 255, 0.88);
	}

	.latest-section--home .latest-item a {
		background: #ffffff;
		border: 1px solid rgba(20, 33, 61, 0.08);
	}

	.latest-section--landing .latest-item a:hover,
	.latest-section--landing .latest-item a:focus-visible {
		transform: translateX(4px);
		background: #fff;
		box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
	}

	.latest-section--home .latest-item a:hover,
	.latest-section--home .latest-item a:focus-visible {
		transform: translateY(-2px);
		border-color: rgba(143, 59, 46, 0.25);
		box-shadow: 0 14px 28px rgba(20, 33, 61, 0.08);
	}

	.latest-index {
		display: grid;
		place-items: center;
		width: 2.6rem;
		height: 2.6rem;
		border-radius: 999px;
		background: var(--latest-accent-soft);
		color: var(--latest-accent);
		font-size: 0.9rem;
		font-weight: 700;
	}

	.latest-copy h3 {
		margin: 0 0 0.25rem;
		color: var(--latest-ink);
	}

	.latest-section--landing .latest-copy h3 {
		font-size: 1.15rem;
	}

	.latest-section--home .latest-copy h3 {
		font-size: 1.05rem;
	}

	.latest-copy p {
		margin: 0;
		color: var(--latest-muted);
		line-height: 1.6;
	}

	.latest-section--landing .latest-copy p {
		font-size: 0.94rem;
	}

	.latest-date {
		color: var(--latest-muted);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-align: right;
	}

	.empty-state {
		border: 1px dashed rgba(15, 23, 42, 0.18);
		color: var(--latest-muted);
		background: rgba(255, 255, 255, 0.72);
	}

	.latest-section--landing .empty-state {
		padding: 2rem;
		border-radius: 20px;
	}

	.latest-section--home .empty-state {
		padding: 1.5rem;
		border-radius: 18px;
	}

	@media (max-width: 900px) {
		.latest-section--landing .section-heading {
			align-items: start;
			flex-direction: column;
		}
	}

	@media (max-width: 720px) {
		.latest-item a {
			grid-template-columns: auto 1fr;
		}

		.latest-date {
			grid-column: 2;
			text-align: left;
		}
	}
</style>
