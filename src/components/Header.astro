---
import { SITE_TITLE } from "../consts";
import HeaderSimple from "./HeaderSimple.astro";
import HeaderDropdown from "./HeaderDropdown.astro";
import SocialLinks from "./SocialLinks.astro";
---

<header>
	<nav class="navbar">
		<div class="navbar-left">
			<h2 class="site-logo"><a href="/">{SITE_TITLE}</a></h2>
			<button
				class="mobile-menu-toggle"
				aria-label="Toggle menu"
				aria-expanded="false"
			>
				<svg
					width="24"
					height="24"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<line x1="3" y1="12" x2="21" y2="12"></line>
					<line x1="3" y1="6" x2="21" y2="6"></line>
					<line x1="3" y1="18" x2="21" y2="18"></line>
				</svg>
			</button>
		</div>

		<div class="nav-content">
			<div class="nav-categories">
				<HeaderSimple title="/">Home</HeaderSimple>
				<HeaderSimple title="/about">About me</HeaderSimple>
				<HeaderSimple title="/publications">Publications</HeaderSimple>
				<HeaderSimple title="/teaching">Teaching</HeaderSimple>
				<HeaderSimple title="/curriculum">CV</HeaderSimple>

				<HeaderDropdown title="Blog" url="#" mega={true}>
					<div class="mega-menu-grid">
						<div class="mega-column">
							<a href="/blog"><h4>Tech Blog</h4></a>
							<a href="/blog/research">Research</a>
							<a href="/blog/software_engineering"
								>Software Engineering</a
							>
							<a href="/blog/machine_learning">Machine Learning</a
							>
							<a href="/blog/devops">DevOps</a>
							<a href="/blog/projects">Projects</a>
							<a href="/blog/productivity">Productivity</a>
						</div>
						<div class="mega-column">
							<a href="/opinions"><h4>Opinions</h4></a>
							<a href="/opinions/life">Life</a>
							<a href="/opinions/economy">Economy</a>
							<a href="/opinions/politics-society"
								>Politics and society</a
							>
						</div>
					</div>
				</HeaderDropdown>
			</div>

			<div class="navbar-right">
				<SocialLinks size={24} align="flex-start" />
			</div>
		</div>
	</nav>
</header>

<style>
	header {
		background: white;
		border-bottom: 1px solid #e5e5e5;
		position: sticky;
		top: 0;
		z-index: 100;
	}

	.navbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1440px;
		margin: 0 auto;
		padding: 0 1rem;
		height: 60px;
	}

	.navbar-left {
		flex: 0 0 auto;
	}

	.site-logo {
		margin: 0;
		font-size: 1.2rem;
		font-weight: 700;
		letter-spacing: 0.05em;
	}

	.site-logo a {
		color: var(--black);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.site-logo a:hover {
		color: var(--accent);
	}

	.nav-categories {
		display: flex;
		align-items: center;
		gap: 0;
		flex: 1;
		justify-content: center;
		margin: 0 2rem;
	}

	.navbar-right {
		flex: 0 0 auto;
	}

	.mobile-menu-toggle {
		display: none;
		background: none;
		border: none;
		cursor: pointer;
		color: var(--black);
		padding: 0.5rem;
	}

	.nav-content {
		display: flex;
		flex: 1;
		align-items: center;
		justify-content: space-between;
	}

	@media (max-width: 1024px) {
		.navbar {
			flex-wrap: wrap;
			height: auto;
			padding: 0.5rem 1rem;
		}

		.navbar-left {
			width: 100%;
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: 0;
		}

		.mobile-menu-toggle {
			display: block;
		}

		.nav-content {
			display: none;
			width: 100%;
			flex-direction: column;
		}

		.nav-content.is-open {
			display: flex;
		}

		.nav-categories {
			width: 100%;
			flex-direction: column;
			gap: 0;
			margin: 1rem 0;
			justify-content: flex-start;
		}

		.navbar-right {
			width: 100%;
			margin-top: 0.5rem;
			padding-top: 1rem;
			padding-bottom: 0.5rem;
			border-top: 1px solid #e5e5e5;
			display: flex;
			justify-content: center;
		}
	}
</style>

<style is:global>
	.mega-menu-grid {
		display: flex;
		gap: 2.5rem;
	}

	.mega-column h4 {
		margin: 0 0 0.5rem 0.5rem;
		font-size: 0.9rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: rgb(var(--gray));
		border-bottom: 2px solid var(--accent);
		padding-bottom: 0.25rem;
		display: inline-block;
	}

	@media (max-width: 1024px) {
		.mega-menu-grid {
			flex-direction: column;
			gap: 1.5rem;
			padding-top: 0.5rem;
		}

		.mega-column h4 {
			margin-left: 0;
		}
	}
</style>

<script>
	const menuToggle = document.querySelector(".mobile-menu-toggle");
	const navContent = document.querySelector(".nav-content");

	if (menuToggle && navContent) {
		menuToggle.addEventListener("click", () => {
			const isExpanded =
				menuToggle.getAttribute("aria-expanded") === "true";
			menuToggle.setAttribute("aria-expanded", String(!isExpanded));
			navContent.classList.toggle("is-open");
		});
	}
</script>
