---
interface Props {
    title: string;
}

const { title } = Astro.props;
---

<a href={title} class="nav-item"><slot /></a>

<style>
    .nav-item {
        padding: 0.75rem 1rem;
        color: var(--black);
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 500;
        border: none;
        background: none;
        cursor: pointer;
        transition:
            color 0.2s ease,
            border-bottom-color 0.2s ease;
        border-bottom: 3px solid transparent;
        position: relative;
        display: block;
    }

    .nav-item:hover {
        color: var(--accent);
        border-bottom-color: var(--accent);
    }

    @media (max-width: 768px) {
        .nav-item {
            width: 100%;
            padding: 0.75rem 0;
            border: none;
            border-bottom: 1px solid #e5e5e5;
        }
    }
</style>
