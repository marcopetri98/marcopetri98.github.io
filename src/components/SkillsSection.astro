---
interface SkillGroup {
    name: string;
    skills: string[];
}

interface Props {
    title?: string;
    groups: SkillGroup[];
}

const { title = "Skills", groups } = Astro.props;
---

<section class="skills">
    <div class="section-heading">
        <h2>{title}</h2>
    </div>

    <ol class="skills-list">
        {
            groups.map((group) => (
                <li class="skill-card">
                    <article>
                        <h3>{group.name}</h3>
                        <ul class="skill-tags">
                            {group.skills.map((skill) => (
                                <li>{skill}</li>
                            ))}
                        </ul>
                    </article>
                </li>
            ))
        }
    </ol>
</section>

<style>
    .skills {
        width: 100%;
        max-width: 720px;
        margin: 0 auto;
    }

    .section-heading {
        margin-bottom: 1.25rem;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid var(--accent);
    }

    .section-heading h2 {
        margin: 0;
        font-size: 1.9rem;
        color: rgb(var(--gray-dark));
    }

    .skills-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 1rem;
    }

    .skill-card {
        margin: 0;
        padding: 1.5rem;
        background: rgba(var(--section-dark), 0.12);
        border: 1px solid rgba(var(--section-dark), 0.24);
        border-radius: 12px;
    }

    .skill-card h3 {
        margin: 0 0 1rem;
        font-size: 1.2rem;
        line-height: 1.35;
        color: rgb(var(--gray-dark));
    }

    .skill-tags {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 0;
        padding: 0;
    }

    .skill-tags li {
        padding: 0.25rem 0.7rem;
        border-radius: 999px;
        background: rgba(var(--section-light), 0.65);
        color: var(--accent-dark);
        font-size: 0.85rem;
    }

    @media (max-width: 720px) {
        .section-heading h2 {
            font-size: 1.6rem;
        }

        .skill-card {
            padding: 1.1rem;
        }
    }
</style>
